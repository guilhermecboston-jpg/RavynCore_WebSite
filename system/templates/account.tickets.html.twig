<section class="rc-ticket-page">
  <h2 class="rc-title-ornate">Support Ticket</h2>

  {% if errors is not empty %}
    {{ include('error_box.html.twig', { errors: errors }) }}
  {% endif %}

  {% if success is not empty %}
    <div class="rc-ticket-success">{{ success }}</div>
  {% endif %}

  <div class="rc-ticket-card">
    <div class="rc-ticket-toolbar rc-ticket-toolbar-actions">
      <a href="#rcTicketAddForm" class="rc-btn rc-btn-primary">Add Ticket</a>
      <a href="?subtopic=accountmanagement&action=tickets" class="rc-btn rc-btn-subtle">Show all</a>
      {% if isStaff and openTicketsCount > 0 %}
        <span class="rc-ticket-admin-reminder rc-ticket-admin-reminder-inline">{{ openTicketsCount }}</span>
      {% endif %}
    </div>

    <div class="rc-character-table-wrap">
      <table class="rc-character-table rc-ticket-table rc-ticket-list-compact">
        <thead>
        <tr>
          <th style="width: 80px;">ID</th>
          <th style="width: 140px;">Category</th>
          <th>Subject</th>
          <th style="width: 170px;">Status</th>
          <th style="width: 170px;">Updated</th>
          <th style="width: 130px;">Action</th>
        </tr>
        </thead>
        <tbody>
        {% if myTickets|length > 0 %}
          {% for ticket in myTickets %}
            <tr>
              <td>#{{ ticket.id }}</td>
              <td>{{ typeOptions[ticket.ticket_type] ?? ticket.ticket_type|capitalize }}</td>
              <td class="rc-ticket-description-cell">
                <strong>{{ ticket.title }}</strong>
                <small>{{ ticket.summary }}</small>
              </td>
              <td class="rc-ticket-status-cell"><span class="rc-ticket-status rc-ticket-status-{{ ticket.status|e('html_attr') }}">{{ ticket.status_label }}</span></td>
              <td>{{ ticket.updated_at|date("d/m/Y H:i") }}</td>
              <td class="rc-ticket-status-cell">
                <a href="?subtopic=accountmanagement&action=tickets&view_ticket={{ ticket.id }}" class="rc-btn rc-btn-subtle rc-character-mini-btn">View Ticket</a>
              </td>
            </tr>
          {% endfor %}
        {% else %}
          <tr>
            <td colspan="6">No tickets found.</td>
          </tr>
        {% endif %}
        </tbody>
      </table>
    </div>
  </div>

  <div id="rcTicketAddForm" class="rc-ticket-card">
    <h3 class="rc-title-ornate rc-title-ornate-inline">Add Ticket</h3>
    <form method="post" action="?subtopic=accountmanagement&action=tickets" class="rc-ticket-form">
      <div class="rc-ticket-grid">
        <label>
          <span>Character</span>
          <select name="character_id" required>
            {% for character in characters %}
              <option value="{{ character.id }}" {% if selectedCharacterId == character.id %}selected{% endif %}>{{ character.name }}</option>
            {% endfor %}
          </select>
        </label>

        <label>
          <span>Category</span>
          <select name="ticket_type" required>
            {% for key, label in typeOptions %}
              <option value="{{ key }}" {% if ticketType == key %}selected{% endif %}>{{ label }}</option>
            {% endfor %}
          </select>
        </label>

        <label class="rc-ticket-grid-full">
          <span>Subject</span>
          <input type="text" name="ticket_title" maxlength="120" value="{{ ticketTitle|e }}" required>
        </label>

        <label class="rc-ticket-grid-full">
          <span>Description</span>
          <textarea name="ticket_description" rows="6" required>{{ ticketDescription|e }}</textarea>
          <small>Use only text and YouTube/Imgur links.</small>
        </label>
      </div>
      <div class="rc-ticket-actions">
        <a href="?subtopic=accountmanagement" class="rc-btn rc-btn-subtle">Back</a>
        <button type="submit" name="create_ticket" value="1" class="rc-btn rc-btn-primary">Create Ticket</button>
      </div>
    </form>
  </div>

  {% if selectedTicket %}
    <div class="rc-ticket-card">
      <h3 class="rc-title-ornate rc-title-ornate-inline">View Ticket</h3>
      <div class="rc-ticket-card-sub">
        <div class="rc-ticket-item-title">Ticket #{{ selectedTicket.id }}</div>
        <div class="rc-ticket-detail-grid">
          <span>Character:</span><strong>{{ selectedTicket.character_name }}</strong>
          <span>Subject:</span><strong>{{ selectedTicket.title }}</strong>
          <span>Category:</span><strong>{{ typeOptions[selectedTicket.ticket_type] ?? selectedTicket.ticket_type|capitalize }}</strong>
          <span>Status:</span><strong><span class="rc-ticket-status rc-ticket-status-{{ selectedTicket.status|e('html_attr') }}">{{ selectedTicket.status_label }}</span></strong>
          <span>Created:</span><strong>{{ selectedTicket.created_at|date("d/m/Y H:i") }}</strong>
          <span>Last Update:</span><strong>{{ selectedTicket.updated_at|date("d/m/Y H:i") }}</strong>
        </div>
      </div>
    </div>

    <div class="rc-ticket-card">
      <h3 class="rc-title-ornate rc-title-ornate-inline">Messages</h3>
      <div class="rc-ticket-messages">
        {% if selectedTicket.history is defined and selectedTicket.history|length > 0 %}
          {% for item in selectedTicket.history %}
            <article class="rc-ticket-message {{ item.actor_role == 'staff' ? 'is-staff' : 'is-player' }}">
              <header>
                <strong>
                  {% if item.actor_role == 'staff' %}
                    Staff {{ item.actor_name is not empty ? item.actor_name : ('#' ~ item.actor_account_id) }}
                  {% else %}
                    {{ item.actor_name is not empty ? item.actor_name : 'Player' }}
                  {% endif %}
                </strong>
                <time>{{ item.created_at|date("d/m/Y H:i") }}</time>
              </header>
              <p>{{ item.message is not empty ? item.message : '-' }}</p>
              <small>Status: {{ statusMap[item.status] ?? item.status }}</small>
            </article>
          {% endfor %}
        {% else %}
          <div class="rc-ticket-description-full">No messages yet.</div>
        {% endif %}
      </div>
    </div>

    <div class="rc-ticket-card">
      <h3 class="rc-title-ornate rc-title-ornate-inline">Add Reply</h3>
      <form method="post" action="?subtopic=accountmanagement&action=tickets&view_ticket={{ selectedTicket.id }}" class="rc-ticket-form rc-ticket-reply-form">
        <input type="hidden" name="ticket_id" value="{{ selectedTicket.id }}">
        {% if isStaff %}
          <label>
            <span>Status</span>
            <select name="staff_status">
              {% for statusKey, statusLabel in statusMap %}
                <option value="{{ statusKey }}" {% if selectedTicket.status == statusKey %}selected{% endif %}>{{ statusLabel }}</option>
              {% endfor %}
            </select>
          </label>
        {% endif %}
        <label class="rc-ticket-grid-full">
          <span>Message</span>
          <textarea name="reply_message" rows="7" maxlength="5000" placeholder="Type your message..."></textarea>
          <small>Up to 5000 characters. Only text and YouTube/Imgur links are allowed.</small>
        </label>
        <div class="rc-ticket-actions rc-ticket-actions-center">
          <button type="submit" name="ticket_add_reply" value="1" class="rc-btn rc-btn-primary">Send Reply</button>
        </div>
      </form>
    </div>
  {% endif %}
</section>
