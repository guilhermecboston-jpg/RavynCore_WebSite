{% set rows = 0 %}
{% set group = player.getGroup() %}
{% set characterCharmPoints = charmPoints is defined ? charmPoints : (charm_points is defined ? charm_points : 0) %}
{% set characterFullAddons = fullAddons is defined ? fullAddons : (full_addons is defined ? full_addons : 0) %}
{% set characterFullMounts = fullMounts is defined ? fullMounts : (full_mounts is defined ? full_mounts : 0) %}
{% set characterLoyaltyTitle = loyaltyTitle is defined ? loyaltyTitle : (loyalty_title is defined ? loyalty_title : (loyalty_title_name is defined ? loyalty_title_name : '-')) %}

{% if canEdit %}
  <a href="admin/?p=players&id={{ player.getId() }}" title="Edit in Admin Panel" target="_blank">
    {% set button_name = 'Edit Character' %}
    {% include('buttons.base.html.twig') %}
  </a>
  <br>
{% endif %}

<table border="0" cellpadding="0" cellspacing="0" width="100%">
  <tr>
    <td>
      <div class="TableContainer">
        <div class="CaptionContainer">
          <div class="CaptionInnerContainer">
            <span class="CaptionEdgeLeftTop" style="background-image:url({{ template_path }}/images/global/content/box-frame-edge.gif);"></span>
            <span class="CaptionEdgeRightTop" style="background-image:url({{ template_path }}/images/global/content/box-frame-edge.gif);"></span>
            <span class="CaptionBorderTop" style="background-image:url({{ template_path }}/images/global/content/table-headline-border.gif);"></span>
            <span class="CaptionVerticalLeft" style="background-image:url({{ template_path }}/images/global/content/box-frame-vertical.gif);"></span>
            <div class="Text">Character Information</div>
            <span class="CaptionVerticalRight" style="background-image:url({{ template_path }}/images/global/content/box-frame-vertical.gif);"></span>
            <span class="CaptionBorderBottom" style="background-image:url({{ template_path }}/images/global/content/table-headline-border.gif);"></span>
            <span class="CaptionEdgeLeftBottom" style="background-image:url({{ template_path }}/images/global/content/box-frame-edge.gif);"></span>
            <span class="CaptionEdgeRightBottom" style="background-image:url({{ template_path }}/images/global/content/box-frame-edge.gif);"></span>
          </div>
        </div>
        <table class="Table3" cellpadding="0" cellspacing="0">
          <tbody>
          <tr>
            <td>
              <div class="InnerTableContainer">
                <table style="width:100%;">
                  <tbody>
                  <tr>
                    <td>
                      <div class="TableContentContainer">
                        <table class="TableContent" width="100%" style="border:1px solid #faf0d7;">
                          <tbody>
                          {% set rows = rows + 1 %}
                          <tr bgcolor="{{ getStyle(rows) }}">
                            <td width="22%" class="LabelV175">Name:</td>
                            <td>
                              {% if skull is not null %}<img src="images/{{ skull }}.gif">{% endif %}
                              {{ player.getName() }}
                              {% if player.isOnline() %}
                                <img src="{{ template_path }}/images/on.gif" title="Online">
                              {% else %}
                                <img src="{{ template_path }}/images/off.gif" title="Offline">
                              {% endif %}
                            </td>
                          </tr>

                          {% if oldName is not null and oldName|trim != '' %}
                            {% set rows = rows + 1 %}
                            <tr bgcolor="{{ getStyle(rows) }}">
                              <td class="LabelV175">Former Names:</td>
                              <td>{{ oldName|raw }}</td>
                            </tr>
                          {% endif %}

                          {% set rows = rows + 1 %}
                          <tr bgcolor="{{ getStyle(rows) }}">
                            <td class="LabelV175">Sex:</td>
                            <td>{{ sex }}</td>
                          </tr>

                          {% set rows = rows + 1 %}
                          <tr bgcolor="{{ getStyle(rows) }}">
                            <td class="LabelV175">Vocation:</td>
                            <td>{{ vocation }}</td>
                          </tr>

                          {% set rows = rows + 1 %}
                          <tr bgcolor="{{ getStyle(rows) }}">
                            <td class="LabelV175">Level:</td>
                            <td>{{ player.getLevel() }}</td>
                          </tr>

                          {% set rows = rows + 1 %}
                          <tr bgcolor="{{ getStyle(rows) }}">
                            <td class="LabelV175">World:</td>
                            <td>{{ config.lua.serverName }}</td>
                          </tr>

                          {% set rows = rows + 1 %}
                          <tr bgcolor="{{ getStyle(rows) }}">
                            <td class="LabelV175">Residence:</td>
                            <td>{{ town }}</td>
                          </tr>

                          {% if guild.rank is not null %}
                            {% set rows = rows + 1 %}
                            <tr bgcolor="{{ getStyle(rows) }}">
                              <td class="LabelV175">Guild:</td>
                              <td>{{ guild.rank }} of the {{ guild.link|raw }}</td>
                            </tr>
                          {% endif %}

                          {% set rows = rows + 1 %}
                          <tr bgcolor="{{ getStyle(rows) }}">
                            <td class="LabelV175">Last Login:</td>
                            <td>{% if player.getLastLogin() == 0 %}Never logged in.{% else %}{{ player.getLastLogin()|date("j M Y, H:i") }}{% endif %}</td>
                          </tr>

                          {% set rows = rows + 1 %}
                          <tr bgcolor="{{ getStyle(rows) }}">
                            <td class="LabelV175">Account Status:</td>
                            <td>
                              {% if vip_enabled %}
                                VIP
                                {% if account.isPremium() %}
                                  <span style="color: #2ea043;"><b>active</b></span>
                                {% else %}
                                  <span style="color: #d73a49;"><b>inactive</b></span>
                                {% endif %}
                              {% else %}
                                {% if account.isPremium() %}
                                  <span style="color: #2ea043;"><b>Premium Account</b></span>
                                {% else %}
                                  <span style="color: #d73a49;"><b>Free Account</b></span>
                                {% endif %}
                              {% endif %}
                            </td>
                          </tr>

                          </tbody>
                        </table>
                      </div>
                    </td>
                  </tr>
                  </tbody>
                </table>
              </div>
            </td>
          </tr>
          </tbody>
        </table>
      </div>
    </td>
  </tr>
</table>
<br>

{{ hook(constant('HOOK_CHARACTERS_BEFORE_DEATHS')) }}
<div class="TableContainer">
  <div class="CaptionContainer">
    <div class="CaptionInnerContainer">
      <span class="CaptionEdgeLeftTop" style="background-image:url({{ template_path }}/images/global/content/box-frame-edge.gif);"></span>
      <span class="CaptionEdgeRightTop" style="background-image:url({{ template_path }}/images/global/content/box-frame-edge.gif);"></span>
      <span class="CaptionBorderTop" style="background-image:url({{ template_path }}/images/global/content/table-headline-border.gif);"></span>
      <span class="CaptionVerticalLeft" style="background-image:url({{ template_path }}/images/global/content/box-frame-vertical.gif);"></span>
      <div class="Text">Character Deaths</div>
      <span class="CaptionVerticalRight" style="background-image:url({{ template_path }}/images/global/content/box-frame-vertical.gif);"></span>
      <span class="CaptionBorderBottom" style="background-image:url({{ template_path }}/images/global/content/table-headline-border.gif);"></span>
      <span class="CaptionEdgeLeftBottom" style="background-image:url({{ template_path }}/images/global/content/box-frame-edge.gif);"></span>
      <span class="CaptionEdgeRightBottom" style="background-image:url({{ template_path }}/images/global/content/box-frame-edge.gif);"></span>
    </div>
  </div>
  <table class="Table3" cellpadding="0" cellspacing="0">
    <tbody>
    <tr>
      <td>
        <div class="InnerTableContainer">
          <table style="width:100%;">
            <tbody>
            <tr>
              <td>
                <div class="TableContentContainer">
                  <table class="TableContent" width="100%" style="border:1px solid #faf0d7;">
                    <tbody>
                    <tr bgcolor="{{ config.darkborder }}">
                      <td width="24%"><b>Date</b></td>
                      <td><b>Description</b></td>
                    </tr>
                    {% if deaths|length > 0 %}
                      {% for death in deaths %}
                        {% set rows = rows + 1 %}
                        <tr bgcolor="{{ getStyle(rows) }}">
                          <td>{{ death.time|date("j M Y, H:i") }}</td>
                          <td>{{ death.description|raw }}</td>
                        </tr>
                      {% endfor %}
                    {% else %}
                      {% set rows = rows + 1 %}
                      <tr bgcolor="{{ getStyle(rows) }}">
                        <td colspan="2">No deaths recorded for this character.</td>
                      </tr>
                    {% endif %}
                    </tbody>
                  </table>
                </div>
              </td>
            </tr>
            </tbody>
          </table>
        </div>
      </td>
    </tr>
    </tbody>
  </table>
</div>
<br>

<div class="TableContainer">
  <div class="CaptionContainer">
    <div class="CaptionInnerContainer">
      <span class="CaptionEdgeLeftTop" style="background-image:url({{ template_path }}/images/global/content/box-frame-edge.gif);"></span>
      <span class="CaptionEdgeRightTop" style="background-image:url({{ template_path }}/images/global/content/box-frame-edge.gif);"></span>
      <span class="CaptionBorderTop" style="background-image:url({{ template_path }}/images/global/content/table-headline-border.gif);"></span>
      <span class="CaptionVerticalLeft" style="background-image:url({{ template_path }}/images/global/content/box-frame-vertical.gif);"></span>
      <div class="Text">Account Badges</div>
      <span class="CaptionVerticalRight" style="background-image:url({{ template_path }}/images/global/content/box-frame-vertical.gif);"></span>
      <span class="CaptionBorderBottom" style="background-image:url({{ template_path }}/images/global/content/table-headline-border.gif);"></span>
      <span class="CaptionEdgeLeftBottom" style="background-image:url({{ template_path }}/images/global/content/box-frame-edge.gif);"></span>
      <span class="CaptionEdgeRightBottom" style="background-image:url({{ template_path }}/images/global/content/box-frame-edge.gif);"></span>
    </div>
  </div>
  <table class="Table3" cellpadding="0" cellspacing="0">
    <tbody>
    <tr>
      <td>
        <div class="InnerTableContainer">
          <table style="width:100%;">
            <tbody>
            <tr>
              <td>
                <div class="TableContentContainer">
                  <table class="TableContent" width="100%" style="border:1px solid #faf0d7;">
                    <tbody>
                    <tr bgcolor="{{ getStyle(rows + 1) }}">
                      <td style="text-align: center;">
                        {% if achievementPoints > 0 %}
                          {% for achievement in achievements %}
                            {% if achievement is not empty %}
                              {% for i in 1..achievement.grade %}
                                <img src="{{ BASE_URL }}images/global/general/achievement-grade-symbol.gif" alt="badge">
                              {% endfor %}
                              {% if achievement.secret == 1 %}
                                <img src="{{ BASE_URL }}images/global/general/achievement-secret-symbol.gif" alt="secret badge">
                              {% endif %}
                            {% endif %}
                          {% endfor %}
                        {% else %}
                          No badges available.
                        {% endif %}
                      </td>
                    </tr>
                    </tbody>
                  </table>
                </div>
              </td>
            </tr>
            </tbody>
          </table>
        </div>
      </td>
    </tr>
    </tbody>
  </table>
</div>
<br>

