{% set group = player.getGroup() %}
{% set characterCharmPoints = charmPoints is defined ? charmPoints : (charm_points is defined ? charm_points : 0) %}
{% set characterFullAddons = fullAddons is defined ? fullAddons : (full_addons is defined ? full_addons : 0) %}
{% set characterFullMounts = fullMounts is defined ? fullMounts : (full_mounts is defined ? full_mounts : 0) %}
{% set characterLoyaltyTitle = loyaltyTitle is defined ? loyaltyTitle : (loyalty_title is defined ? loyalty_title : (loyalty_title_name is defined ? loyalty_title_name : '-')) %}

<div class="rc-character-page">
  {% if canEdit %}
    <div class="rc-character-toolbar">
      <a href="admin/?p=players&id={{ player.getId() }}" title="Edit in Admin Panel" target="_blank">
        {% set button_name = 'Edit Character' %}
        {% include('buttons.base.html.twig') %}
      </a>
    </div>
  {% endif %}

  <section class="rc-character-card rc-character-card-info">
    <h4 class="rc-character-card-title">CHARACTER INFORMATION</h4>
    <div class="rc-character-table-wrap">
      <table class="rc-character-table rc-character-meta-table">
        <tbody>
        <tr>
          <td class="rc-character-label-cell">Name:</td>
          <td class="rc-character-value-cell">
            {% if skull is not null %}<img src="images/{{ skull }}.gif" alt="Skull"> {% endif %}
            {{ player.getName() }} {{ oldName }}
          </td>
        </tr>
        <tr>
          <td class="rc-character-label-cell">Sex:</td>
          <td class="rc-character-value-cell">{{ sex }}</td>
        </tr>
        <tr>
          <td class="rc-character-label-cell">Vocation:</td>
          <td class="rc-character-value-cell">{{ vocation }}</td>
        </tr>
        <tr>
          <td class="rc-character-label-cell">Level:</td>
          <td class="rc-character-value-cell">{{ player.getLevel() }}</td>
        </tr>
        <tr>
          <td class="rc-character-label-cell">World:</td>
          <td class="rc-character-value-cell">{{ config.lua.serverName }}</td>
        </tr>
        <tr>
          <td class="rc-character-label-cell">Residence:</td>
          <td class="rc-character-value-cell">{{ town }}</td>
        </tr>
        <tr>
          <td class="rc-character-label-cell">Guild:</td>
          <td class="rc-character-value-cell">
            {% if guild.rank is not null %}
              {{ guild.rank }} of the {{ guild.link|raw }}
            {% else %}
              -
            {% endif %}
          </td>
        </tr>
        <tr>
          <td class="rc-character-label-cell">Last Login:</td>
          <td class="rc-character-value-cell">{% if player.getLastLogin() == 0 %}Never logged in.{% else %}{{ player.getLastLogin()|date("j M Y, H:i") }}{% endif %}</td>
        </tr>
        <tr>
          <td class="rc-character-label-cell">Created:</td>
          <td class="rc-character-value-cell">{{ account.getCreated()|date("j M Y, H:i") }}</td>
        </tr>
        <tr>
          <td class="rc-character-label-cell">Position:</td>
          <td class="rc-character-value-cell">{% if group.isLoaded() and group.getId() != 1 %}{{ group.getName()|capitalize }}{% else %}-{% endif %}</td>
        </tr>
        <tr>
          <td class="rc-character-label-cell">Account Status:</td>
          <td class="rc-character-value-cell">
            {% if vip_enabled %}
              VIP
              {% if account.isPremium() %}
                <strong class="rc-status-online">actived</strong> until {{ account.getExpirePremiumTime()|date("j M Y, H:i") }}
              {% else %}
                <strong class="rc-status-offline">desactivated</strong>
              {% endif %}
            {% else %}
              {% if account.isPremium() %}
                <strong class="rc-status-online">Premium Account</strong>
              {% else %}
                <strong class="rc-status-offline">Free Account</strong>
              {% endif %}
            {% endif %}
          </td>
        </tr>
        </tbody>
      </table>
    </div>
  </section>

  {{ hook(constant('HOOK_CHARACTERS_BEFORE_DEATHS')) }}

  <section class="rc-character-card rc-character-card-deaths">
    <h4 class="rc-character-card-title">DEATH LIST</h4>
    <div class="rc-character-table-wrap">
      <table class="rc-character-table">
        <thead>
        <tr>
          <th style="width: 220px;">Date</th>
          <th>Description</th>
        </tr>
        </thead>
        <tbody>
        {% if deaths|length > 0 %}
          {% for death in deaths %}
            <tr>
              <td>{{ death.time|date("j M Y, H:i") }}</td>
              <td>{{ death.description|raw }}</td>
            </tr>
          {% endfor %}
        {% else %}
          <tr>
            <td colspan="2">No deaths</td>
          </tr>
        {% endif %}
        </tbody>
      </table>
    </div>
  </section>

  <section class="rc-character-card rc-character-card-account">
    <h4 class="rc-character-card-title">ACCOUNT INFORMATION</h4>
    <div class="rc-character-table-wrap">
      <table class="rc-character-table rc-character-meta-table">
        <tbody>
        <tr>
          <td class="rc-character-label-cell">Loyalty Title:</td>
          <td class="rc-character-value-cell">{{ characterLoyaltyTitle }}</td>
        </tr>
        <tr>
          <td class="rc-character-label-cell">Points:</td>
          <td class="rc-character-value-cell">{{ achievementPoints }}</td>
        </tr>
        <tr>
          <td class="rc-character-label-cell">Charm Points:</td>
          <td class="rc-character-value-cell">{{ characterCharmPoints }}</td>
        </tr>
        <tr>
          <td class="rc-character-label-cell">Full Addons:</td>
          <td class="rc-character-value-cell">{{ characterFullAddons }}</td>
        </tr>
        <tr>
          <td class="rc-character-label-cell">Full Mounts:</td>
          <td class="rc-character-value-cell">{{ characterFullMounts }}</td>
        </tr>
        </tbody>
      </table>
    </div>
  </section>

  {% if not hidden %}
    <section class="rc-character-card rc-character-card-list">
      <h4 class="rc-character-card-title">CHARACTER LIST</h4>
      <div class="rc-character-table-wrap">
        <table class="rc-character-table">
          <thead>
          <tr>
            <th>Name</th>
            <th style="width: 260px;">Vocation</th>
            <th style="width: 120px;">Level</th>
            <th style="width: 120px;">Status</th>
            <th style="width: 160px;">Action</th>
          </tr>
          </thead>
          <tbody>
          {% set visibleCharacters = 0 %}
          {% for accountPlayer in account_players %}
            {% if not accountPlayer.isHidden() and (config('characters')['deleted'] or not accountPlayer.isDeleted()) %}
              {% set visibleCharacters = visibleCharacters + 1 %}
              <tr>
                <td>{{ accountPlayer.getName() }}{% if accountPlayer.isDeleted() %} <span class="rc-status-offline">[DELETED]</span>{% endif %}</td>
                <td>{{ accountPlayer.getVocationName() }}</td>
                <td>{{ accountPlayer.getLevel() }}</td>
                <td>
                  {% if accountPlayer.isOnline() %}
                    <span class="rc-status-online">Online</span>
                  {% else %}
                    <span class="rc-status-offline">Offline</span>
                  {% endif %}
                </td>
                <td class="rc-character-action-cell">
                  <form action="{{ characters_link }}" method="post" class="rc-character-view-form">
                    <input type="hidden" name="name" value="{{ accountPlayer.getName() }}">
                    {% set button_name = 'View' %}
                    {% set button_title = accountPlayer.getName() %}
                    {{ include('buttons.base.html.twig') }}
                  </form>
                </td>
              </tr>
            {% endif %}
          {% endfor %}
          {% if visibleCharacters == 0 %}
            <tr>
              <td colspan="5">No characters found for this account.</td>
            </tr>
          {% endif %}
          </tbody>
        </table>
      </div>
    </section>
  {% endif %}

  {% if search_form is defined and search_form %}
    <section class="rc-character-card rc-character-card-search">
      <h4 class="rc-character-card-title">SEARCH CHARACTER</h4>
      <div class="rc-character-search-host">
        {{ search_form|raw }}
      </div>
    </section>
  {% endif %}

  {{ hook(constant('HOOK_CHARACTERS_AFTER_CHARACTERS')) }}
</div>
