                        <tr>
                          <td class="LabelV">Address:</td>
                          <td style="width:90%;">{{ account_location is not empty ? account_location : '-' }}</td>
                        </tr>
                        <tr>
                          <td class="LabelV">Phone:</td>
                          <td style="width:90%;">{{ account_phone is not empty ? account_phone : '-' }}</td>
                        </tr>
                        <tr>
                          <td class="LabelV">Location:</td>
                          <td style="width:90%;">{{ account_location is not empty ? account_location : '-' }}</td>
                        </tr>
                        {% if account_show_rk and recovery_key is not empty %}
                          <tr>
                            <td class="LabelV">RK:</td>
                            <td style="width:90%;">{{ recovery_key }}</td>
                          </tr>
                        {% endif %}
                      {% endif %}
                    </table>
                  </div>
                </div>
              </td>
            </tr>
            {% if recovery_key is not empty and not account_update_info_on_register %}
              <tr>
                <td>
                  <table class="InnerTableButtonRow" cellpadding="0" cellspacing="0">
                    <tr>
                      <td width="100%"></td>
                      <td>
                        <form action="{{ getLink('account/info') }}" method="post" class="rc-inline-form">
                          <button type="submit" class="rc-btn rc-btn-subtle">Edit Contact Info</button>
                        </form>
                      </td>
                    </tr>
                  </table>
                </td>
              </tr>
            {% endif %}
          </table>
        </div>
      </td>
    </tr>
  </table>
</div>
